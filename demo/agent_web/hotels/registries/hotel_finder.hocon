{
    "metadata": {
        "description": "Hotel inventory and ranking agent for hotels.example",
        "tags": ["agent_web", "demo", "hotels"],
        "branding": {
            "name": "Nest Hotels",
            "tagline": "Stay anywhere, feel at home",
            "logo": "🏨",
            "primary_color": "#B8552C",
            "accent_color": "#F2A65A",
            "background": "#FBF5EE",
            "foreground": "#3a2418",
            "muted": "#8a6f5b",
            "card": "#ffffff",
            "font_stack": "Georgia, 'Times New Roman', serif",
        },
    },
    "llm_config": {
        "model_name": "claude-haiku",
        # Full-chain BYOK — see flight_finder.hocon for the rationale.
        # The calling client supplies the key via sly_data.llm_config;
        # trip_planner forwards it inward via allow.to_downstream;
        # hotel_finder uses that same key for its own LLM calls.
        "anthropic_api_key": "sly_data",
    },
    "tools": [
        {
            "name": "hotel_finder",
            "function": {
                "description": """
Searches a private hotel inventory and ranks results against user preferences.
search_hotels runs on hotels.example servers; score_hotel runs in the
caller's runtime (it ships as Python source).
""",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "request": {
                            "type": "string",
                            "description": "User's hotel request"
                        },
                    },
                    "required": ["request"]
                },
            },
            "instructions": """
You are the hotel_finder agent.  Call search_hotels with the right city,
checkin, checkout, and max_price.  Then for each candidate hotel, call
score_hotel with its amenities and the user's preferences to compute a
ranking score.  Return the top hotels sorted by score.

Be concise: return at most the top 3 hotels with their name, area, nightly
USD price, score, and a one-line reason.
""",
            "tools": ["search_hotels", "score_hotel"],
        },

        {
            "name": "search_hotels",
            "function": {
                "description": "Searches the hotels.example private inventory",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "city": {"type": "string"},
                        "checkin": {"type": "string", "description": "YYYY-MM-DD"},
                        "checkout": {"type": "string", "description": "YYYY-MM-DD"},
                        "max_price_usd": {"type": "number"},
                    },
                    "required": ["city", "checkin", "checkout"],
                },
            },
            "class": "search_hotels.SearchHotels",
        },

        {
            "name": "score_hotel",
            "function": {
                "description": "Computes a preference score for a single hotel",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "amenities": {
                            "type": "array",
                            "items": {"type": "string"},
                        },
                        "user_preferences": {
                            "type": "array",
                            "items": {"type": "string"},
                        },
                        "price_usd": {"type": "number"},
                    },
                    "required": ["name", "amenities", "user_preferences", "price_usd"],
                },
            },
            "client_side": true,
            "class": "score_hotel.ScoreHotel",
        },
    ],
}
