# Valid: Bare {type: "object"} with no properties is a legitimate
# JSON-Schema / OpenAI shape for a function that takes no arguments.
# Expected result: 0 errors.
{
    "tools": [
        {
            "name": "noop",
            "function": {
                "description": "Takes no arguments",
                "parameters": {"type": "object"}
            },
            "instructions": "test"
        }
    ]
}
