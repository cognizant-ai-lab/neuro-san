# Valid: String references like "items": "cao_item" are resolved by
# DictionaryCommonDefsConfigFilter before the validator runs in production.
# Without a commondefs section, the string stays as-is and the validator
# should silently skip it (no false positives).
# Expected result: 0 errors.
{
    "tools": [
        {
            "name": "esp_tool",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_defs": {
                            "type": "array",
                            "items": "cao_item"
                        }
                    }
                }
            },
            "instructions": "test"
        }
    ]
}
