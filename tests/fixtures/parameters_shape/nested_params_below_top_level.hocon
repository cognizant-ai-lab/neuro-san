# Error: A stray 'parameters' key inside a property's own schema
# (one level below the top).
# Expected result: 1 error mentioning "parameters.properties.arg1"
# and "nested 'parameters'".
{
    "tools": [
        {
            "name": "tool_a",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "arg1": {
                            "type": "object",
                            # This 'parameters' key is the bug — it should not
                            # appear inside a property schema.
                            "parameters": {
                                "type": "object",
                                "properties": {"foo": {"type": "string"}}
                            }
                        }
                    },
                    "required": ["arg1"]
                }
            },
            "instructions": "test"
        }
    ]
}
