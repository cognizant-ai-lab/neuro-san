# Error: Three levels deep — level2 defines "val" but requires "missing_key".
# The full dotted path should appear in the error message.
# Expected result: 1 error mentioning
# "parameters.properties.level1.properties.level2.required".
{
    "tools": [
        {
            "name": "deep_tool",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "level1": {
                            "type": "object",
                            "properties": {
                                "level2": {
                                    "type": "object",
                                    "properties": {
                                        "val": {"type": "string"}
                                    },
                                    "required": ["missing_key"]
                                }
                            }
                        }
                    }
                }
            },
            "instructions": "test"
        }
    ]
}
