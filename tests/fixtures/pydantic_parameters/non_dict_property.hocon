# Error: A property whose value is a scalar string instead of a dict.
# Caught by pre-flight validation.
# Expected result: 1 error mentioning "must be an object".
{
    "tools": [
        {
            "name": "agent_h",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "name": "should_be_a_dict"
                    }
                }
            },
            "instructions": "test"
        }
    ]
}
