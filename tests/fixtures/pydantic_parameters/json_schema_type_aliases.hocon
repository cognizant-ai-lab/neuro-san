# Standard JSON Schema / OpenAI function spec type names ("integer",
# "number", "bool") are accepted via TYPE_LOOKUP aliases, both as scalar
# property types and inside array "items".
# Expected result: no errors.
{
    "tools": [
        {
            "name": "agent_a",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "count": {"type": "integer"},
                        "score": {"type": "number"},
                        "enabled": {"type": "bool"},
                        "readings": {
                            "type": "array",
                            "items": {"type": "number"}
                        },
                        "ids": {
                            "type": "array",
                            "items": {"type": "integer"}
                        }
                    },
                    "required": ["count"]
                }
            },
            "instructions": "test"
        }
    ]
}
